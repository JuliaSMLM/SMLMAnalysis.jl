    given-names: Keith A.
    email: klidke@unm.edu
    affiliation: "University of New Mexico"
version: 0.1.0
license: MIT
repository-code: "https://github.com/JuliaSMLM/SMLMAnalysis.jl"
url: "https://JuliaSMLM.github.io/SMLMAnalysis.jl/"
keywords:
  - single-molecule localization microscopy
  - super-resolution microscopy
  - SMLM
  - Julia
